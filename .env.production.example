# ==============================================================================
# VETCONNECT MONOREPO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Coolify VPS / Vercel / Supabase / LiveKit Cloud Deployment
# ==============================================================================

# Backend Node.js / Express Settings
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Supabase PostgreSQL Cloud Database (Prisma 6)
# DATABASE_URL uses transaction pooler port 6543 with pgbouncer=true
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"
# DIRECT_URL uses direct session port 5432 for Prisma migrations
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Upstash or VPS Redis Session Store (Socket.io Adapter & Cache)
REDIS_URL="rediss://default:[PASSWORD]@[HOST].upstash.io:6379"

# Authentication Dual JWT Secrets (min 32 characters)
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_LONG_JWT_SECRET_KEY"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_LONG_REFRESH_SECRET"

# LiveKit WebRTC Cloud Credentials
LIVEKIT_URL="wss://vetconnect.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxx"
LIVEKIT_API_SECRET="secret_xxxxxxxxx"

# AWS S3 / Cloudflare R2 Secure Medical Storage (Optional)
STORAGE_PROVIDER="s3" # "local" or "s3"
S3_BUCKET_NAME="vetconnect-medical-media-prod"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="AKIAxxxxxxxx"
S3_SECRET_ACCESS_KEY="secret_xxxxxxxxx"

# CORS & Frontend URLs
CORS_ORIGIN="https://app.vetconnect.com,https://admin.vetconnect.com"
COOKIE_SAME_SITE="none"
COOKIE_SECURE="true"

# Web SPA Frontend Environment Variables (Vite)
VITE_API_URL="https://api.vetconnect.com"
VITE_LIVEKIT_URL="wss://vetconnect.livekit.cloud"

# Expo Mobile App Public Variables
EXPO_PUBLIC_API_URL="https://api.vetconnect.com"
EXPO_PUBLIC_WEB_URL="https://app.vetconnect.com"
