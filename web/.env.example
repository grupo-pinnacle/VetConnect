# Backend API Base URL (Express REST & Socket.io)
# In production: e.g. https://api.vetconnect.com.ar or your Coolify/VPS URL
VITE_API_URL="http://localhost:3001"
VITE_WS_URL="http://localhost:3001"
VITE_LIVEKIT_URL="ws://localhost:7880"

# Sentry Production Telemetry & Error Tracking (Optional)
# Paste your project DSN from sentry.io
VITE_SENTRY_DSN=""
