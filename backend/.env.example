# ==============================================================================
# VetConnect Backend Environment Variables (Production & Staging Template)
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://vetconnect:vetconnect_password@localhost:5432/vetconnect?schema=public"

# Authentication & JWT Secrets (HMAC-SHA256)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"

# Redis Cache & Socket.io Adapter (Redis 7)
REDIS_URL="redis://localhost:6379"

# CORS & Cross-Origin Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN="https://vet-connect-web.vercel.app,https://app.vetconnect.com.ar"
FRONTEND_URL="https://vet-connect-web.vercel.app"
CLIENT_URL="https://app.vetconnect.com.ar"

# Session Cookie Options for Cross-Domain Web / Subdomains
# In production across different domains (e.g. vercel.app -> api.vetconnect.com.ar):
# COOKIE_SECURE must be true (requires HTTPS on both sides)
# COOKIE_SAME_SITE must be none
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=.vetconnect.com.ar # Optional: Set only if web and api share the root domain

# WebRTC Video Calling — LiveKit Cloud (SFU)
LIVEKIT_URL="wss://vetconnect-mrsu677e.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# Clinical Media & Storage (Local vs S3)
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
# AWS S3 (When STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="vetconnect-media-prod"
