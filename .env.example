# =====================================================================
# VetConnect — Plantilla Maestra de Variables de Entorno (.env.example)
# =====================================================================
# INSTRUCCIONES:
# Copiar este archivo a backend/.env para desarrollo local:
#   cp .env.example backend/.env
# NUNCA commitear archivos .env con credenciales reales a Git.
# =====================================================================

# --- ENTORNO & SERVIDOR (Backend) ---
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- BASE DE DATOS (PostgreSQL / Supabase / Local Docker) ---
# Conexión local predeterminada con docker-compose:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/vetconnect_dev?schema=public&connection_limit=10"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/vetconnect_dev?schema=public"

# --- SEGURIDAD & AUTENTICACIÓN (JWT) ---
# Generar claves criptográficas seguras en producción: openssl rand -base64 32
JWT_SECRET="dev-jwt-secret-key-change-in-production-min-32-chars-long"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="dev-refresh-secret-key-change-in-production-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# --- REDIS (Cache, Rate Limiting & Socket.io Adapter) ---
# Requerido en producción (ADR-009). Opcional en desarrollo local sin Redis.
REDIS_URL="redis://localhost:6379"

# --- WEBRTC & TELEMEDICINA (LiveKit Cloud o Local) ---
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_URL="wss://vetconnect-dev.livekit.cloud"

# --- ALMACENAMIENTO DE ARCHIVOS & MULTIMEDIA (ADR-010, ADR-020) ---
# Opciones: local | s3
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Configuración S3 (Obligatorio si STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="vetconnect-media"

# --- NOTIFICACIONES PUSH (Mobile Expo) ---
EXPO_PUSH_ACCESS_TOKEN=""
EXPO_PUSH_DISABLED="true"

# --- FRONTEND WEB (web/.env) ---
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
VITE_LIVEKIT_URL=wss://vetconnect-dev.livekit.cloud

# --- MOBILE (mobile/.env o app.json) ---
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WS_URL=http://localhost:3001
